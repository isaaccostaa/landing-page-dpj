{
  "name": "Landing page DPJ",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "python -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt && cd frontend && npm install",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Landing page", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss", "ms-python.python"]
    }
  }
}
